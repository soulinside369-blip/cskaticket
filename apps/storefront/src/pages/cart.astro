---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`Корзина и оформление — ${SITE.name}`}>
  <section class="container checkout">
    <h1 class="display page-title">Оформление</h1>

    <div class="empty card" data-empty hidden>
      <p>В корзине пока нет билетов.</p>
      <a class="btn btn-primary" href={`${base}#afisha`}>Выбрать матч</a>
    </div>

    <div class="grid" data-filled hidden>
      <form class="card form" id="checkout" novalidate>
        <h2 class="step-title"><span>1</span> Контакты</h2>
        <p class="hint">Сюда придут электронные билеты и чек.</p>
        <div class="fields">
          <label>Имя и фамилия<input type="text" name="name" autocomplete="name" required /></label>
          <label>Email для билетов<input type="email" name="email" autocomplete="email" required /></label>
          <label>Телефон<input type="tel" name="phone" autocomplete="tel" placeholder="+7" required /></label>
        </div>

        <h2 class="step-title"><span>2</span> Способ оплаты</h2>
        <div class="methods" role="radiogroup" aria-label="Способ оплаты">
          <label class="method"><input type="radio" name="method" value="card" checked /> <span><b>Банковская карта</b><small>Мир, Visa, Mastercard — на странице платёжного провайдера</small></span></label>
          <label class="method"><input type="radio" name="method" value="sbp" /> <span><b>СБП</b><small>Оплата по QR-коду из приложения банка</small></span></label>
        </div>

        <h2 class="step-title"><span>3</span> Подтверждение</h2>
        <label class="consent"><input type="checkbox" name="offer" required /> <span>Принимаю условия <a href={`${base}legal/#offer`} target="_blank">публичной оферты</a> и <a href={`${base}legal/#refund`} target="_blank">возврата</a></span></label>
        <label class="consent"><input type="checkbox" name="pd" required /> <span>Согласен на <a href={`${base}legal/#privacy`} target="_blank">обработку персональных данных</a></span></label>
        <p class="error" role="alert" hidden></p>
        <button class="btn btn-primary btn-lg pay-btn" type="submit">Перейти к оплате</button>
        <p class="hint small">Вы перейдёте на защищённую страницу платёжного провайдера. Данные карты не передаются на этот сайт.</p>
      </form>

      <aside class="card summary" aria-label="Ваш заказ">
        <div class="hold" data-hold>
          <span>Места забронированы ещё</span> <b class="num" data-timer>15:00</b>
        </div>
        <ul class="items" data-items role="list"></ul>
        <dl class="totals num">
          <div><dt>Билеты</dt><dd data-t-ticket></dd></div>
          <div><dt>Услуги сервиса</dt><dd data-t-fee></dd></div>
          <div class="grand"><dt>Итого к оплате</dt><dd data-t-total></dd></div>
        </dl>
        <p class="hint small">Продавец: {SITE.seller.legalName}, ИНН {SITE.seller.inn}</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { readCart, removeItem, track } from '../lib/cart';
  const rate = 0.1;
  const rub = (n: number) => n.toLocaleString('ru-RU') + ' ₽';
  const split = (t: number) => { const ticket = Math.round(t / (1 + rate) / 10) * 10; return { ticket, fee: t - ticket }; };
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const base = document.body.dataset.base || '/';

  function render() {
    const cart = readCart();
    const has = cart.items.length > 0;
    $('[data-empty]').hidden = has;
    $('[data-filled]').hidden = !has;
    if (!has) return;
    const list = $('[data-items]');
    list.innerHTML = '';
    cart.items.forEach((it, i) => {
      const li = document.createElement('li');
      li.innerHTML = `<div><b>${it.matchTitle}</b><span>${it.date}</span><span class="num">Сектор ${it.sector} · ряд ${it.row} · место ${it.seat}</span></div>` +
        `<div class="it-r"><b class="num">${rub(it.price)}</b><button type="button" aria-label="Удалить место ${it.seat}">Удалить</button></div>`;
      li.querySelector('button')!.addEventListener('click', () => { removeItem(i); render(); });
      list.appendChild(li);
    });
    const total = cart.items.reduce((a, x) => a + x.price, 0);
    const fee = cart.items.reduce((a, x) => a + split(x.price).fee, 0);
    $('[data-t-ticket]').textContent = rub(total - fee);
    $('[data-t-fee]').textContent = rub(fee);
    $('[data-t-total]').textContent = rub(total);
  }

  function tick() {
    const c = readCart();
    if (!c.holdUntil) return;
    const left = Math.max(0, c.holdUntil - Date.now());
    $('[data-timer]').textContent = `${String(Math.floor(left / 60000)).padStart(2, '0')}:${String(Math.floor(left / 1000) % 60).padStart(2, '0')}`;
    if (left === 0) { render(); }
  }
  render(); tick(); setInterval(tick, 1000);
  if (readCart().items.length) track('checkout_start', { items: readCart().items.length });

  const form = document.getElementById('checkout') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const err = form.querySelector<HTMLElement>('.error')!;
    const fd = new FormData(form);
    const problems: string[] = [];
    if (!String(fd.get('name') || '').trim()) problems.push('укажите имя');
    if (!/^\S+@\S+\.\S+$/.test(String(fd.get('email') || ''))) problems.push('проверьте email');
    if (String(fd.get('phone') || '').replace(/\D/g, '').length < 10) problems.push('проверьте телефон');
    if (!fd.get('offer') || !fd.get('pd')) problems.push('отметьте согласия');
    if (problems.length) { err.textContent = 'Чтобы продолжить: ' + problems.join(', ') + '.'; err.hidden = false; return; }
    err.hidden = true;
    track('lead', { method: fd.get('method') });
    location.href = `${base}pay/?method=${fd.get('method')}`; // в проде — URL платежа от провайдера
  });
</script>

<style>
  .checkout { margin-top: var(--space-6); }
  .page-title { font-size: var(--text-3xl); margin: 0 0 var(--space-5); }
  .empty { padding: var(--space-6); display: grid; gap: var(--space-4); justify-items: start; }
  .grid { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 980px) { .grid { grid-template-columns: minmax(0, 1fr) 400px; } }
  .form, .summary { padding: var(--space-5); }
  @media (min-width: 980px) { .summary { position: sticky; top: 84px; } }
  .step-title { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-lg); margin: var(--space-5) 0 var(--space-3); }
  .step-title:first-child { margin-top: 0; }
  .step-title span { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: var(--text-sm); }
  .hint { color: var(--text-muted); font-size: var(--text-sm); margin: 0 0 var(--space-3); }
  .small { font-size: var(--text-xs); margin-top: var(--space-3); }
  .fields { display: grid; gap: var(--space-3); }
  @media (min-width: 640px) { .fields { grid-template-columns: 1fr 1fr; } .fields label:first-child { grid-column: 1 / -1; } }
  .fields label { display: grid; gap: 6px; font-size: var(--text-sm); color: var(--text-muted); }
  .methods { display: grid; gap: var(--space-2); }
  .method { display: flex; gap: var(--space-3); align-items: start; padding: var(--space-4); border: 1px solid var(--border-strong); border-radius: var(--radius-md); cursor: pointer; }
  .method:has(input:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .method span { display: grid; } .method small { color: var(--text-muted); }
  input[type="radio"], input[type="checkbox"] { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--accent); flex: none; }
  .consent { display: flex; gap: var(--space-3); align-items: start; font-size: var(--text-sm); margin-bottom: var(--space-3); }
  .error { color: var(--danger); font-size: var(--text-sm); }
  .pay-btn { width: 100%; margin-top: var(--space-3); }
  .hold { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--surface-2); font-size: var(--text-sm); margin-bottom: var(--space-4); }
  .hold b { font-size: var(--text-lg); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .items :global(li) { display: flex; justify-content: space-between; gap: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid var(--border); font-size: var(--text-sm); }
  .items :global(li div) { display: grid; gap: 2px; }
  .items :global(li span) { color: var(--text-muted); }
  .items :global(.it-r) { text-align: right; justify-items: end; }
  .items :global(button) { background: none; border: 0; color: var(--text-muted); text-decoration: underline; cursor: pointer; font-size: var(--text-xs); padding: 0; }
  .totals { margin: var(--space-4) 0 0; display: grid; gap: var(--space-2); }
  .totals div { display: flex; justify-content: space-between; color: var(--text-muted); font-size: var(--text-sm); }
  .totals dd { margin: 0; }
  .totals .grand { color: var(--text); font-weight: 700; font-size: var(--text-lg); padding-top: var(--space-2); border-top: 1px solid var(--border); }
</style>
