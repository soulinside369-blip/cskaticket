---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`Заказ оформлен — ${SITE.name}`}>
  <section class="container done">
    <div class="card box">
      <div class="ok" aria-hidden="true">✓</div>
      <h1 class="display title">Заказ оплачен</h1>
      <p class="muted">Номер заказа <b class="num" data-id>—</b>. Электронные билеты отправлены на указанный email (в демо — не отправляются).</p>
      <ul class="items" data-items role="list"></ul>
      <div class="next">
        <h2>Что дальше</h2>
        <ol>
          <li>Откройте письмо с билетами — QR-код можно показать с телефона.</li>
          <li>Входы открываются за 1,5 часа до начала; номер входа указан в билете.</li>
          <li>Вернуть билет можно по <a href={`${base}legal/#refund`}>условиям возврата</a>.</li>
        </ol>
      </div>
      <a class="btn btn-primary" href={base}>На главную</a>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../lib/cart';
  let order: any = null;
  try { order = JSON.parse(sessionStorage.getItem('cskaticket:last-order') || 'null'); } catch {}
  if (order) {
    document.querySelector('[data-id]')!.textContent = order.id;
    document.querySelector('[data-items]')!.innerHTML = order.items
      .map((i: any) => `<li><b>${i.matchTitle}</b> · ${i.date}<br><span class="num">Сектор ${i.sector}, ряд ${i.row}, место ${i.seat}</span></li>`).join('');
    clearCart();
  }
</script>

<style>
  .done { margin-top: var(--space-7); display: grid; place-items: center; }
  .box { max-width: 620px; width: 100%; padding: var(--space-6); }
  .ok { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--success); color: #fff; font-size: 28px; font-weight: 700; }
  .title { font-size: var(--text-3xl); margin: var(--space-4) 0 var(--space-2); }
  .muted { color: var(--text-muted); }
  .items { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .items :global(li) { padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .next h2 { font-size: var(--text-lg); }
  .next ol { color: var(--text-muted); padding-left: 20px; display: grid; gap: 6px; margin-bottom: var(--space-5); }
</style>
