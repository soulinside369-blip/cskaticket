---
// Оболочка макета: одна страница, экраны рендерит клиентский роутер (src/app).
// Тема собирается при сборке из пресета с проверкой контраста (packages/theme).
import '../styles/global.css';
import '../styles/app.css';
import '../styles/intro.css';
import { buildTheme, type ThemePreset } from '@platform/theme';
import preset from '../../../../packages/theme/presets/cska.json';
import { SITE } from '../lib/site';
const THEME = buildTheme(preset as ThemePreset);
const s = SITE.seller;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#070D1C" />
  <title>{SITE.name} — {SITE.tagline}</title>
  <meta name="description" content={SITE.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Unbounded:wght@500;700;800;900&display=swap" rel="stylesheet" />
  <style set:html={THEME.css}></style>
</head>
<body>
  <a class="skip" href="#app">К содержанию</a>
  <div class="demo-bar" role="note">
    Демо-макет для согласования · матчи, места и цены тестовые · оплата не проводится
  </div>

  <!-- SellerBar: фиксированный блок продавца (DESIGN.md §5) -->
  <div class="seller-bar">
    <div class="container seller-inner">
      <span>Продавец: <b>{s.legalName}</b>, ИНН {s.inn}</span>
      <nav aria-label="Документы продавца">
        <a href="#/legal?to=offer">Оферта</a>
        <a href="#/legal?to=refund">Возврат</a>
        <a href="#/legal?to=contacts">Контакты</a>
      </nav>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#/" aria-label={`${SITE.name} — на главную`}>
        <span class="placeholder logo-slot" title="RIGHTS-001: ждём файл логотипа от партнёра">лого<br /><b>RIGHTS-001</b></span>
        <span class="wordmark display">{SITE.name}</span>
      </a>
      <nav class="main-nav" aria-label="Основное меню">
        <a href="#/?to=afisha">Афиша</a>
        <a href="#/?to=arena">Арена</a>
        <a href="#/?to=faq">Вопросы</a>
      </nav>
      <a class="cart-link" href="#/cart" aria-label="Корзина">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 7h18l-1.5 11a2 2 0 0 1-2 1.8H6.5a2 2 0 0 1-2-1.8L3 7Zm5 0V6a4 4 0 0 1 8 0v1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <span class="cart-count num" data-cart-count>0</span>
      </a>
    </div>
  </header>

  <main id="app" tabindex="-1"></main>

  <!-- LegalFooter: фиксированные цвета, тема не переопределяет -->
  <footer class="legal-footer">
    <div class="container footer-grid">
      <div>
        <div class="display footer-name">{SITE.name}</div>
        <p class="disclaimer">{SITE.disclaimer}</p>
        <p class="disclaimer">Итоговая цена билета включает стоимость услуг билетного сервиса; раскладка показывается до оплаты.</p>
      </div>
      <div>
        <h2>Продавец</h2>
        <p>{s.legalName}<br />ИНН {s.inn} · ОГРН {s.ogrn}<br />{s.address}<br />{s.email} · {s.phone}</p>
      </div>
      <div>
        <h2>Документы</h2>
        <p><a href="#/legal?to=offer">Публичная оферта</a><br /><a href="#/legal?to=refund">Условия возврата</a><br /><a href="#/legal?to=privacy">Политика обработки ПДн</a></p>
        <p class="disclaimer">Оплата — через лицензированного платёжного провайдера: банковские карты, СБП. Данные карт не хранятся на сайте.</p>
      </div>
    </div>
  </footer>

  <script>
    import '../app/main';
  </script>
</body>
</html>
