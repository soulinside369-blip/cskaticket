---
import Base from '../../layouts/Base.astro';
import IcePattern from '../../components/IcePattern.astro';
import { inventory, arena, minPrice, totalFree } from '../../lib/inventory';
import { SITE, fmtDate, rub } from '../../lib/site';
import { VIEWBOX, rinkPath, TIERS } from '../../lib/arena';
import { priceLevels } from '../../lib/priceColors';

export function getStaticPaths() {
  return inventory.listMatches().map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const match = inventory.getMatch(slug!)!;
const inv = inventory.getInventory(match.slug);
const geo = arena();
const d = fmtDate(match.date);
const from = minPrice(inv);
const free = totalFree(inv);
const invById = new Map(inv.map((s) => [s.id, s]));
const { levels, cmap } = priceLevels(inv.filter((s) => s.free > 0).map((s) => s.price));
const maxPrice = Math.max(...inv.map((s) => s.price));
const minAll = from ?? 0;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = `ЦСКА — ${match.opponent}`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'SportsEvent', name: title,
  startDate: `${match.date}:00+03:00`, eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: SITE.venue.name, address: SITE.venue.address },
  offers: from ? { '@type': 'AggregateOffer', priceCurrency: 'RUB', lowPrice: from, highPrice: maxPrice, availability: 'https://schema.org/InStock' } : undefined,
};
const payload = {
  slug: match.slug, title, date: match.date, dateLabel: `${d.day} ${d.month}, ${d.time}`,
  inv, colors: Object.fromEntries(cmap), feeRate: SITE.serviceFeeRate,
};
---
<Base title={`Билеты: ${title}, ${d.day} ${d.month} — ${SITE.name}`} jsonld={jsonld}>
  <section class="match-head">
    <IcePattern seed={match.slug.length * 13} />
    <div class="container head-inner">
      <a class="back" href={`${base}#afisha`}>← Все матчи</a>
      <p class="eyebrow">{match.tournament}</p>
      <h1 class="display m-title">ЦСКА <span class="vs">—</span> {match.opponent}</h1>
      <dl class="m-meta">
        <div><dt>Дата</dt><dd class="num">{d.day} {d.month}, {d.wdFull}</dd></div>
        <div><dt>Начало</dt><dd class="num">{d.time} МСК</dd></div>
        <div><dt>Арена</dt><dd>{SITE.venue.name}</dd></div>
        <div><dt>Билеты</dt><dd class="num">{from ? `от ${rub(from)}` : 'нет в продаже'} · свободно {free.toLocaleString('ru-RU')}</dd></div>
      </dl>
    </div>
  </section>

  <section class="container picker" id="seats" aria-label="Выбор мест">
    <!-- Схема -->
    <div class="map-card card">
      <div class="map-toolbar">
        <ul class="legend" aria-label="Обозначения">
          <li><i class="lg free"></i>Свободно</li>
          <li><i class="lg sel"></i>Выбрано</li>
          <li><i class="lg held"></i>В брони</li>
          <li><i class="lg sold"></i>Продано</li>
          <li><i class="lg wheel"></i>Для МГН</li>
        </ul>
        <div class="zoom-btns">
          <button class="icon-btn" data-zoom="in" aria-label="Приблизить">+</button>
          <button class="icon-btn" data-zoom="out" aria-label="Отдалить">−</button>
          <button class="icon-btn wide" data-zoom="reset">Вся арена</button>
        </div>
      </div>
      <div class="map-wrap">
        <svg id="arena" class="arena" viewBox={`${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.w} ${VIEWBOX.h}`} role="application" aria-label="Схема арены. Выберите сектор, затем места.">
          <defs>
            <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="6" stroke="#9AA3B5" stroke-width="2" />
            </pattern>
          </defs>
          <path d={rinkPath(0)} class="rink" />
          <path d={rinkPath(-12)} class="rink-inner" />
          <line x1="0" y1="-138" x2="0" y2="138" class="rink-red" />
          <line x1="-100" y1="-146" x2="-100" y2="146" class="rink-blue" />
          <line x1="100" y1="-146" x2="100" y2="146" class="rink-blue" />
          <circle cx="0" cy="0" r="34" class="rink-circle" />
          <text x="0" y="6" class="rink-label">ЛЁД</text>
          {TIERS.map((t) => (
            <g class="tier" data-tier={t.id}>
              {geo.filter((g) => g.tier === t.id).map((g) => {
                const s = invById.get(g.id)!;
                const soldOut = s.free === 0;
                return (
                  <g class={`sector${soldOut ? ' soldout' : ''}`} data-sector={g.id} data-price={s.price}
                     tabindex="0" role="button"
                     aria-label={`Сектор ${g.id}, ${soldOut ? 'мест нет' : `от ${s.price} рублей, свободно ${s.free}`}`}>
                    <path d={g.path} style={soldOut ? undefined : `--c:${cmap.get(s.price)}`} />
                    <text x={g.label[0].toFixed(1)} y={(g.label[1] - 4).toFixed(1)} class="s-id">{g.id}</text>
                    <text x={g.label[0].toFixed(1)} y={(g.label[1] + 13).toFixed(1)} class="s-price">{soldOut ? '—' : `${(s.price / 1000).toFixed(1).replace('.', ',')}к`}</text>
                  </g>
                );
              })}
            </g>
          ))}
          <g id="seats-layer"></g>
          <g id="highlight-layer"></g>
        </svg>
        <div class="tooltip" role="status" aria-live="polite" hidden></div>
        <div class="coach" hidden>
          <span>Колесо мыши или щипок — масштаб, перетаскивание — сдвиг. На клавиатуре: Tab к сектору, Enter, затем стрелки.</span>
          <button class="icon-btn" data-coach-close aria-label="Скрыть подсказку">×</button>
        </div>
      </div>
      <div class="price-legend" aria-label="Цены">
        {levels.map((l) => (
          <span class="pl"><i style={`background:${l.color}`}></i><span class="num">{l.from === l.to ? rub(l.from) : `${rub(l.from)} – ${rub(l.to)}`}</span></span>
        ))}
      </div>
    </div>

    <!-- Панель -->
    <aside class="panel">
      <div class="card block finder">
        <h2 class="block-title">Подобрать места рядом</h2>
        <div class="field-row">
          <span class="field-label" id="party-l">Сколько вас</span>
          <div class="stepper" role="group" aria-labelledby="party-l">
            <button class="icon-btn" data-party="-1" aria-label="Меньше">−</button>
            <output class="num" id="party">2</output>
            <button class="icon-btn" data-party="1" aria-label="Больше">+</button>
          </div>
        </div>
        <label class="field-label" for="budget">Бюджет за билет: <b class="num" id="budget-v">до {rub(maxPrice)}</b></label>
        <input type="range" id="budget" min={minAll} max={maxPrice} step="100" value={maxPrice} />
        <div class="options" id="options" aria-live="polite"></div>
      </div>

      <div class="card block">
        <div class="list-head">
          <h2 class="block-title">Секторы</h2>
          <label class="sort">
            <span class="visually-hidden">Сортировка</span>
            <select id="sort">
              <option value="view">Лучший вид</option>
              <option value="price">Дешевле</option>
              <option value="free">Больше мест</option>
            </select>
          </label>
        </div>
        <ul class="sector-list" id="sector-list" role="list"></ul>
      </div>
    </aside>
  </section>

  <!-- Выбранные места: нижний лист на мобильном, плашка на десктопе -->
  <div class="selection" id="selection" hidden>
    <div class="container sel-inner">
      <div class="sel-info">
        <div class="sel-seats" id="sel-seats"></div>
        <div class="sel-total num" id="sel-total"></div>
      </div>
      <button class="btn btn-primary btn-lg" id="to-cart">В корзину</button>
    </div>
  </div>

  <script type="application/json" id="match-data" set:html={JSON.stringify(payload)}></script>
</Base>

<script>
  import { initSeatMap } from '../../lib/seatmap-client';
  initSeatMap();
</script>

<style>
  .match-head { position: relative; overflow: hidden; background: linear-gradient(160deg, var(--brand) -50%, var(--bg) 70%); border-bottom: 1px solid var(--border); }
  .head-inner { position: relative; padding-top: var(--space-6); padding-bottom: var(--space-6); }
  .back { display: inline-block; color: var(--text-muted); text-decoration: none; font-size: var(--text-sm); margin-bottom: var(--space-4); }
  .m-title { font-size: var(--text-4xl); margin: var(--space-2) 0 var(--space-5); }
  .vs { color: var(--accent); }
  .m-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: 0; }
  @media (min-width: 900px) { .m-meta { grid-template-columns: repeat(4, auto); justify-content: start; gap: var(--space-7); } }
  .m-meta dt { font-size: var(--text-xs); color: var(--text-muted); text-transform: uppercase; letter-spacing: .1em; }
  .m-meta dd { margin: 2px 0 0; font-weight: 600; }

  .picker { display: grid; gap: var(--space-4); margin-top: var(--space-5); align-items: start; }
  @media (min-width: 1080px) { .picker { grid-template-columns: minmax(0, 1fr) 380px; } }
  .map-card { padding: var(--space-3); min-width: 0; }
  .map-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); align-items: center; padding: var(--space-1) var(--space-2) var(--space-3); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin: 0; padding: 0; font-size: var(--text-xs); color: var(--text-muted); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .lg { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .lg.free { background: #5B7CFF; } .lg.sel { background: var(--seat-selected); box-shadow: 0 0 0 2px #fff inset; }
  .lg.held { background: repeating-linear-gradient(45deg, var(--seat-held) 0 2px, transparent 2px 4px); border: 1px solid var(--seat-held); }
  .lg.sold { background: var(--seat-sold); border: 1px solid #3A4459; } .lg.wheel { background: var(--seat-wheel); }
  .zoom-btns { display: flex; gap: var(--space-2); }
  :global(.icon-btn) { min-width: 40px; height: 40px; border-radius: var(--radius-md); border: 1px solid var(--border-strong); background: var(--surface-2); color: var(--text); font-size: 18px; cursor: pointer; display: inline-grid; place-items: center; padding: 0 10px; }
  :global(.icon-btn.wide) { font-size: var(--text-sm); font-weight: 600; }
  :global(.icon-btn:hover) { background: var(--border); }

  .map-wrap { position: relative; border-radius: var(--radius-md); overflow: hidden; background: color-mix(in srgb, var(--bg) 70%, #000); }
  .arena { width: 100%; height: auto; aspect-ratio: 1180 / 880; max-height: 78vh; touch-action: none; cursor: grab; user-select: none; }
  .arena.dragging { cursor: grabbing; }
  .arena :global(.rink) { fill: #E9F1FB; }
  .arena :global(.rink-inner) { fill: none; stroke: #C9D6E8; stroke-width: 1; }
  .arena :global(.rink-red) { stroke: #E4202E; stroke-width: 3; }
  .arena :global(.rink-blue) { stroke: #3D6FD9; stroke-width: 5; }
  .arena :global(.rink-circle) { fill: none; stroke: #3D6FD9; stroke-width: 2; }
  .arena :global(.rink-label) { fill: #8A9AB4; font: 700 22px var(--font-display); text-anchor: middle; letter-spacing: .2em; }
  .arena :global(.sector) { cursor: pointer; outline: none; }
  .arena :global(.sector path) { fill: var(--c, #222a3a); fill-opacity: .85; stroke: var(--bg); stroke-width: 1.5; transition: fill-opacity var(--dur-base) var(--ease); }
  .arena :global(.sector:hover path), .arena :global(.sector:focus-visible path) { fill-opacity: 1; stroke: #fff; stroke-width: 2.5; }
  .arena :global(.sector.soldout path) { fill: #1A2133; fill-opacity: 1; }
  .arena :global(.sector.out path) { fill-opacity: .14; }
  .arena :global(.sector.out text) { opacity: .35; }
  .arena :global(.s-id) { fill: #fff; font: 700 15px var(--font-text); text-anchor: middle; pointer-events: none; }
  .arena :global(.s-price) { fill: #fff; fill-opacity: .85; font: 500 12px var(--font-text); text-anchor: middle; pointer-events: none; }
  .arena.zoomed :global(.sector path) { fill-opacity: .12; }
  .arena.zoomed :global(.sector text) { opacity: 0; }
  :global(#seats-layer) { opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease); }
  .arena.zoomed :global(#seats-layer) { opacity: 1; pointer-events: auto; }
  .arena :global(.seat) { stroke: var(--bg); stroke-width: .8; cursor: pointer; outline: none; }
  .arena :global(.seat.s) { fill: var(--seat-sold); cursor: not-allowed; }
  .arena :global(.seat.h) { fill: url(#hatch); stroke: var(--seat-held); cursor: not-allowed; }
  .arena :global(.seat.w) { fill: var(--seat-wheel); }
  .arena :global(.seat.x) { fill-opacity: .25; cursor: not-allowed; }
  .arena :global(.seat.on) { fill: var(--seat-selected); stroke: #fff; stroke-width: 1.6; }
  .arena :global(.seat:focus-visible) { stroke: var(--focus); stroke-width: 2.5; }
  .arena :global(.seat:hover:not(.s):not(.h):not(.x)) { stroke: #fff; stroke-width: 1.6; }
  .arena :global(.hl) { fill: none; stroke: var(--seat-selected); stroke-width: 2; stroke-dasharray: 4 3; }

  .tooltip { position: absolute; z-index: 5; pointer-events: none; background: #0B0F18; color: #fff; border: 1px solid #2E3850; border-radius: var(--radius-md); padding: 8px 10px; font-size: var(--text-xs); line-height: 1.4; max-width: 240px; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
  .coach { position: absolute; left: 10px; bottom: 10px; max-width: 360px; display: flex; gap: var(--space-2); align-items: start; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--border-strong); border-radius: var(--radius-md); padding: 8px 8px 8px 12px; font-size: var(--text-xs); color: var(--text-muted); }
  .coach .icon-btn { min-width: 28px; height: 28px; font-size: 16px; }
  .price-legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: var(--space-3) var(--space-2) var(--space-1); font-size: var(--text-xs); color: var(--text-muted); }
  .pl { display: inline-flex; align-items: center; gap: 6px; }
  .pl i { width: 14px; height: 8px; border-radius: 2px; display: inline-block; }

  .panel { display: grid; gap: var(--space-4); min-width: 0; }
  /* мобильный: подбор мест — над схемой (путь «3 касания»), список секторов — под ней */
  @media (max-width: 1079px) { .panel { display: contents; } .finder { order: -1; } }
  @media (min-width: 1080px) { .panel { position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; } }
  .block { padding: var(--space-5); }
  .block-title { font-size: var(--text-lg); margin: 0 0 var(--space-4); }
  .field-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); }
  .field-label { font-size: var(--text-sm); color: var(--text-muted); }
  .field-label b { color: var(--text); }
  .stepper { display: flex; align-items: center; gap: var(--space-3); }
  .stepper output { min-width: 20px; text-align: center; font-weight: 700; font-size: var(--text-lg); }
  input[type="range"] { width: 100%; margin: var(--space-3) 0 var(--space-4); accent-color: var(--accent); }
  .options { display: grid; gap: var(--space-2); }
  :global(.opt) { text-align: left; width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 2px var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-strong); background: var(--surface-2); cursor: pointer; color: var(--text); }
  :global(.opt:hover), :global(.opt[aria-pressed="true"]) { border-color: var(--accent); }
  :global(.opt-kind) { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .1em; color: var(--accent); font-weight: 700; }
  :global(.opt-where) { font-weight: 600; }
  :global(.opt-sum) { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-weight: 700; text-align: right; }
  :global(.opt-sum small) { display: block; font-weight: 400; color: var(--text-muted); font-size: var(--text-xs); }
  :global(.opt-empty) { color: var(--text-muted); font-size: var(--text-sm); margin: 0; }

  .list-head { display: flex; justify-content: space-between; align-items: start; }
  select { min-height: 36px; border-radius: var(--radius-md); background: var(--surface-2); border: 1px solid var(--border-strong); padding: 0 8px; }
  .sector-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-height: 360px; overflow: auto; }
  :global(.sl-item) { width: 100%; display: grid; grid-template-columns: 10px 52px 1fr auto; gap: var(--space-3); align-items: center; padding: 10px var(--space-3); border-radius: var(--radius-md); border: 1px solid transparent; background: transparent; cursor: pointer; color: var(--text); text-align: left; }
  :global(.sl-item:hover) { background: var(--surface-2); border-color: var(--border); }
  :global(.sl-item.out) { opacity: .4; }
  :global(.sl-dot) { width: 10px; height: 10px; border-radius: 50%; }
  :global(.sl-id) { font-weight: 700; }
  :global(.sl-meta) { font-size: var(--text-xs); color: var(--text-muted); }
  :global(.sl-price) { font-weight: 600; }

  .selection { position: sticky; bottom: 0; z-index: var(--z-sheet); background: color-mix(in srgb, var(--surface) 96%, transparent); backdrop-filter: blur(10px); border-top: 1px solid var(--border-strong); margin-top: var(--space-5); }
  .sel-inner { display: flex; align-items: center; gap: var(--space-4); padding-top: var(--space-3); padding-bottom: var(--space-3); }
  .sel-info { flex: 1; min-width: 0; }
  .sel-seats { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
  :global(.sel-chip) { flex: none; display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); padding: 4px 4px 4px 10px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border-strong); }
  :global(.sel-chip button) { border: 0; background: transparent; color: var(--text-muted); cursor: pointer; width: 22px; height: 22px; border-radius: 50%; }
  .sel-total { margin-top: 4px; font-size: var(--text-sm); color: var(--text-muted); }
  .sel-total :global(b) { color: var(--text); font-size: var(--text-lg); }
</style>
