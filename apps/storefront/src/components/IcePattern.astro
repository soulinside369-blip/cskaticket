---
// Процедурная фактура «лёд»: следы коньков + разметка. Рисуется кодом по сиду (DESIGN.md §4).
interface Props { seed?: number; class?: string }
const { seed = 7, class: cls = '' } = Astro.props;
let s = seed;
const r = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };
const W = 1200, H = 600;
const scratches = Array.from({ length: 70 }, () => {
  const x = r() * W, y = r() * H, len = 80 + r() * 320, ang = (r() - 0.5) * 0.9;
  const bend = (r() - 0.5) * 60;
  const x2 = x + Math.cos(ang) * len, y2 = y + Math.sin(ang) * len;
  const cx = (x + x2) / 2 - Math.sin(ang) * bend, cy = (y + y2) / 2 + Math.cos(ang) * bend;
  return { d: `M${x.toFixed(0)},${y.toFixed(0)} Q${cx.toFixed(0)},${cy.toFixed(0)} ${x2.toFixed(0)},${y2.toFixed(0)}`, o: (0.08 + r() * 0.22).toFixed(2), w: (0.5 + r() * 1.2).toFixed(1) };
});
const frost = Array.from({ length: 140 }, () => ({ x: r() * W, y: r() * H, rr: 0.6 + r() * 1.6, o: (0.05 + r() * 0.2).toFixed(2) }));
---
<svg class={`ice ${cls}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={`glow${seed}`} cx="70%" cy="20%" r="80%">
      <stop offset="0" stop-color="#8FB8FF" stop-opacity=".22" />
      <stop offset="1" stop-color="#8FB8FF" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#glow${seed})`} />
  <g stroke="#E4202E" stroke-opacity=".35" stroke-width="3" fill="none">
    <line x1={W * 0.5} y1="0" x2={W * 0.5} y2={H} />
    <circle cx={W * 0.5} cy={H * 0.5} r="120" stroke="#5B8CFF" stroke-opacity=".3" />
  </g>
  <g stroke="#5B8CFF" stroke-opacity=".28" stroke-width="10">
    <line x1={W * 0.28} y1="0" x2={W * 0.28} y2={H} />
    <line x1={W * 0.72} y1="0" x2={W * 0.72} y2={H} />
  </g>
  <g stroke="#DDE8FF" fill="none" stroke-linecap="round">
    {scratches.map((c) => <path d={c.d} stroke-opacity={c.o} stroke-width={c.w} />)}
  </g>
  <g fill="#DDE8FF">{frost.map((f) => <circle cx={f.x.toFixed(0)} cy={f.y.toFixed(0)} r={f.rr.toFixed(1)} fill-opacity={f.o} />)}</g>
</svg>
<style>
  .ice { position: absolute; inset: 0; width: 100%; height: 100%; opacity: calc(var(--pattern-intensity) * 2.4); pointer-events: none; }
</style>
