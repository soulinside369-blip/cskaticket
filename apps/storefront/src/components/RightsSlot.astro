---
// Слот бренд-материала. Рендерит файл только при наличии действующей записи в docs/ПРАВА.md
// и самого файла от партнёра. Сейчас RIGHTS-001 предварительная, файлов нет → заглушка.
interface Props { slot: string | null; label: string; class?: string; style?: string }
const { slot, label, class: cls = '', style } = Astro.props;
const fileFromPartner: string | null = null; // появится, когда партнёр передаст материалы (S3)
const rightsId = slot?.startsWith('rights:') ? slot.slice(7).split('/')[0] : null;
---
{fileFromPartner && rightsId
  ? <img src={fileFromPartner} alt={label} class={cls} style={style} />
  : <div class={`placeholder ${cls}`} style={style} title={rightsId ? `${rightsId}: ждём файл от партнёра` : 'Нет записи в ПРАВА.md'}>
      <span>{label}<br /><b>{rightsId ?? '[…]'}</b></span>
    </div>}
